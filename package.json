{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "cli-proxy-webui-react",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "bun@1.4.4",
    "scripts": {
        "dev": "vite",
        "build": "bun run type-check && vite build",
        "preview": "vite preview",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings=0",
        "type-check": "node node_modules/@typescript/native/bin/tsc --noEmit && node node_modules/@typescript/native/bin/tsc -p tsconfig.node.json --noEmit",
        "lint:css": "stylelint \"src/**/*.{css,scss}\""
    },
    "dependencies": {
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/merge": "^6.12.3",
        "@codemirror/search": "6.7.2",
        "@codemirror/state": "6.7.6",
        "@codemirror/view": "6.43.15",
        "@uiw/react-codemirror": "^4.25.12",
        "axios": "1.21.1",
        "chart.js": "^4.6.1",
        "i18next": "27.1.3",
        "motion": "14.14.0",
        "motion-dom": "14.14.0",
        "react": "^19.3.1",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^18.0.2",
        "react-router": "8.5.1",
        "yaml": "2.9.1",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "^1.4.4",
        "@types/node": "26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "6.3.0",
        "eslint": "10.15.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.8",
        "globals": "17.14.0",
        "postcss-scss": "^4.0.9",
        "sass": "^1.108.2",
        "stylelint": "18.0.0",
        "stylelint-config-standard": "^41.0.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "8.73.0",
        "vite": "8.3.8",
        "vite-plugin-singlefile": "^2.3.4"
    },
    "overrides": {
        "rolldown": "1.2.18"
    }
}
